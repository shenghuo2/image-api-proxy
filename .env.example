# Generate the admin key with: openssl rand -hex 32
PROXY_ADMIN_KEY=replace-me
# Optional bootstrap token for the first account; later accounts are added in the admin panel.
# PROXY_NAI_TOKEN=your-novelai-token
PROXY_QUEUE_SIZE=64
PROXY_QUOTA_TTL=5m
# Local Go runs serve frontend/dist automatically after `npm run build`.
# Override the static build directory when starting the Go binary elsewhere.
# PROXY_FRONTEND_DIR=/absolute/path/to/frontend/dist
# Set this to the exact frontend origin when hosting it separately.
# PROXY_ADMIN_ORIGIN=https://admin.example.com
# Set this when port 8787 is already in use on the host.
# PROXY_HOST_PORT=18788
# Bind only the intended LAN interface when allowing other devices to connect.
# PROXY_BIND_ADDR=192.168.1.100
# Remote Nginx via a published Docker port: trust only the gateway IP actually seen by the container.
# Restrict that host port so only the Nginx host can connect; see README.md.
# Local Nginx with PROXY_BIND_ADDR=127.0.0.1 needs no explicit CIDR.
# PROXY_TRUSTED_PROXY_CIDRS=172.17.0.1/32
