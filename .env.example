# Generate the admin key with: openssl rand -hex 32
PROXY_ADMIN_KEY=replace-me
# Your server-owned NovelAI token; never give this to clients.
PROXY_NAI_TOKEN=replace-me
PROXY_QUEUE_SIZE=64
PROXY_QUOTA_TTL=5m
# Set this to the exact frontend origin when hosting it separately.
# PROXY_ADMIN_ORIGIN=https://admin.example.com
# Set this when port 8787 is already in use on the host.
# PROXY_HOST_PORT=18788
# Bind only the intended LAN interface when allowing other devices to connect.
# PROXY_BIND_ADDR=192.168.1.100
